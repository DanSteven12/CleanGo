{
  "expo": {
    "name": "CleanGo Ciudadano",
    "slug": "mobile-ciudadano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilecuidadano",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.cleango.mobilecuidadano",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1763A6",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBF_4ISy8XCjWdxVuetx4CXFxslOF_QQKE"
        }
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CleanGo necesita acceso a tus fotos para adjuntar evidencia a tu reporte.",
          "cameraPermission": "CleanGo necesita acceso a tu cámara para tomar evidencia de tu reporte."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CleanGo requiere tu ubicación para registrar el lugar del reporte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}