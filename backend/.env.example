# MySQL connection configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cleango

# Backend server port (optional)
PORT=5001

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Correo (Para recuperar contraseña con Gmail API OAuth2)
EMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Environment / Cookie / DB Security configuration
NODE_ENV=production
COOKIE_NAME=cleango_session
ACCESS_COOKIE_MAX_AGE_MINUTES=15
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
DB_SSL_ENABLED=false
