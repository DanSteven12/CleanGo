# ============================================================
# CleanGo — .gitignore
# ============================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies (Ignora node_modules en la raíz y en cualquier subcarpeta)
node_modules
**/node_modules

# Build outputs (Ignora dist en la raíz y en cualquier subcarpeta)
dist
dist-ssr
**/dist

# Environment files — keep .env.example, ignore real secrets
*.local
.env
**/.env
.env.*
!.env.example
**/.env.*
!**/.env.example

# Explicit production secrets (never commit these)
backend/.env.production
backend/.env.staging
backend/.env.local
frontend/.env.production
frontend/.env.staging
frontend/.env.local

# Database backups / Local dumps (Evita subir datos locales pesados)
*.sql
*.sqlite

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo