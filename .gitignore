# ============================================================
# CleanGo — .gitignore
# ============================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
frontend/node_modules
backend/node_modules

# Build outputs
dist
dist-ssr
frontend/dist
backend/dist

# Environment files — keep .env.example, ignore real secrets
*.local
.env
frontend/.env
backend/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo
